---
import profile from '../data/profile.js'
import SocialLinks from './SocialLinks.astro'

const { name, role, tagline } = profile
const [firstWord, ...restWords] = role.split(' ')
---

<section aria-labelledby="hero-title" class="grid gap-8 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-12">
  <div data-reveal>
    <p class="text-sm text-neutral-400">Hola, soy {name}</p>
    <h1
      id="hero-title"
      class="mt-3 text-5xl leading-[1.05] font-medium tracking-tight text-neutral-100 sm:text-6xl"
    >
      {firstWord}
      <br />
      {restWords.join(' ')}
    </h1>
    <SocialLinks class="mt-8" />
  </div>

  <p
    data-reveal
    class="text-lg leading-relaxed text-neutral-400 md:pt-14 md:text-xl"
    style="transition-delay: 120ms"
  >
    {tagline.before}{' '}<span class="text-accent">{tagline.highlight}</span>{tagline.after}
  </p>
</section>
