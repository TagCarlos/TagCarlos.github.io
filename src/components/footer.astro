---
import credits from '../data/credits.js'
import profile from '../data/profile.js'
import Container from './Container.astro'
import Icon from './Icon.astro'
import SocialLinks from './SocialLinks.astro'

const year = new Date().getFullYear()
---

<footer class="border-t border-white/[0.06] pt-12 pb-10">
  <Container>
    <div class="grid gap-8 md:grid-cols-2">
      <SocialLinks variant="plain" class="-ml-2" />

      <ul class="space-y-2.5 text-xs text-neutral-500">
        {
          credits.map(({ label, name, icon, href }) => (
            <li class="flex items-center gap-3">
              <span class="w-20">{label}</span>
              <a
                href={href}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-2 rounded text-neutral-300 transition-colors duration-300 hover:text-white focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
              >
                <Icon name={icon} class="size-3.5" />
                {name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="mt-12 border-t border-white/[0.06] pt-6 text-xs text-neutral-600">
      © {year} {profile.name}
    </p>
  </Container>
</footer>
