---
// Bloque de detalle de un proyecto: título + párrafo (`text`) o lista (`items`).
const { title, text, items = [] } = Astro.props
---

<div>
  <h4 class="text-xs font-semibold tracking-[0.18em] text-neutral-500 uppercase">{title}</h4>
  {text && <p class="mt-2 text-sm leading-relaxed text-neutral-400">{text}</p>}
  {
    items.length > 0 && (
      <ul class="mt-3 space-y-2">
        {items.map((item) => (
          <li class="flex gap-3 text-sm leading-relaxed text-neutral-400">
            <span aria-hidden="true" class="mt-2 size-1 shrink-0 rounded-full bg-accent" />
            {item}
          </li>
        ))}
      </ul>
    )
  }
</div>
