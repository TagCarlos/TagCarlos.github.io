---
import projects from '../data/projects.js'
import Container from './Container.astro'
import ProjectCard from './ProjectCard.astro'
import SectionHeading from './SectionHeading.astro'
---

<section id="proyectos" aria-labelledby="proyectos-title" class="border-t border-white/[0.06] py-20 md:py-28">
  <Container>
    <SectionHeading id="proyectos-title" eyebrow="Mi Trabajo" title="Proyectos" />

    <div class="mt-14 divide-y divide-white/[0.06]">
      {
        projects.map((project) => (
          <div class="py-16 first:pt-0 last:pb-0 md:py-20">
            <ProjectCard project={project} />
          </div>
        ))
      }
    </div>
  </Container>
</section>
