---
import profile from '../data/profile.js'
import Icon from './Icon.astro'

// variant: 'boxed' (botones con borde, hero) | 'plain' (solo ícono, footer)
const { variant = 'boxed', class: className = '' } = Astro.props

const variants = {
  boxed:
    'size-10 rounded-xl border border-white/10 bg-white/[0.03] hover:-translate-y-0.5 hover:border-white/25 hover:bg-white/[0.06]',
  plain: 'size-9 rounded-lg hover:bg-white/5',
}
---

<ul class:list={['flex gap-2', className]}>
  {
    profile.socials.map(({ label, href, icon }) => (
      <li>
        <a
          href={href}
          target="_blank"
          rel="noreferrer"
          aria-label={label}
          class:list={[
            'flex items-center justify-center text-neutral-400 transition-all duration-300 hover:text-white focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none active:scale-95',
            variants[variant],
          ]}
        >
          <Icon name={icon} class="size-5" />
        </a>
      </li>
    ))
  }
</ul>
