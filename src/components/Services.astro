---
import profile from '../data/profile.js'
import services from '../data/services.js'
import ServiceItem from './ServiceItem.astro'

const { about } = profile
---

<section aria-label="Servicios y sobre mí" class="grid gap-12 md:grid-cols-2 md:gap-16">
  <div data-reveal>
    <h2 class="text-2xl font-medium text-neutral-100 md:text-3xl">Lo que hago</h2>
    <ul class="mt-5 space-y-3">
      {
        services.map((service) => (
          <li>
            <ServiceItem {...service} />
          </li>
        ))
      }
    </ul>
  </div>

  <div data-reveal style="transition-delay: 120ms">
    <h2 class="text-2xl leading-tight font-semibold text-neutral-100 md:text-3xl">
      {about.title}
    </h2>
    <p class="mt-5 text-lg leading-relaxed text-neutral-400">{about.body}</p>
  </div>
</section>
